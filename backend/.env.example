APP_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql+psycopg://goalstream_user:replace-with-your-database-password@localhost:5432/goalstream
FLASK_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_SECRET=replace-with-another-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
COOKIE_SECURE=false

# Choose matchora (no key), api-football, or football-data
FOOTBALL_PROVIDER=matchora
MATCHORA_BASE_URL=https://matchora.pro
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
FOOTBALL_DATA_TOKEN=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
FOOTBALL_PROVIDER_RPM=30
FOOTBALL_PROVIDER_DAILY_LIMIT=90
